# Laravel Application Settings
APP_NAME=Laravel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Oracle Database Connection
DB_CONNECTION=oracle
DB_HOST=Malulu
DB_PORT=1521
DB_DATABASE=XEPDB1
DB_SERVICE_NAME=XEPDB1
DB_USERNAME=laravel
DB_PASSWORD=Larav1234c

# Mail (log driver - emails go to storage/logs/laravel.log)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Laravel Auth"

# Session / Cache
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug
